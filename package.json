{
  "name": "@nyt87/opentrack-viewer",
  "private": true,
  "version": "0.1.0",
  "description": "Open GPX, FIT and TCX activity files locally in your browser. No upload, no account, no backend.",
  "homepage": "https://nyt87.github.io/opentrack-viewer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NYT87/opentrack-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/NYT87/opentrack-viewer/issues"
  },
  "overrides": {
    "glob": "13.0.6"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "fit-file-parser": "5.2.1",
    "gopro-telemetry": "1.2.11",
    "maplibre-gl": "6.14.0",
    "mediabunny": "1.61.5",
    "mp4box": "0.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12"
  }
}
