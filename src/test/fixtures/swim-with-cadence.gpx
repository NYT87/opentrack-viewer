<?xml version="1.0" encoding="UTF-8"?>
<!-- An open-water swim whose <gpxtpx:cad> is strokes per minute, not strides. -->
<gpx version="1.1" creator="OpenTrackViewerTestFixture"
     xmlns="http://www.topografix.com/GPX/1/1"
     xmlns:gpxtpx="http://www.garmin.com/xmlschemas/TrackPointExtension/v1">
  <trk>
    <name>Synthetic Swim</name>
    <type>swimming</type>
    <trkseg>
      <trkpt lat="51.500000" lon="0.0000"><time>2024-01-01T10:00:00Z</time>
        <extensions><gpxtpx:TrackPointExtension><gpxtpx:cad>32</gpxtpx:cad></gpxtpx:TrackPointExtension></extensions></trkpt>
      <trkpt lat="51.500090" lon="0.0000"><time>2024-01-01T10:00:20Z</time>
        <extensions><gpxtpx:TrackPointExtension><gpxtpx:cad>34</gpxtpx:cad></gpxtpx:TrackPointExtension></extensions></trkpt>
    </trkseg>
  </trk>
</gpx>
