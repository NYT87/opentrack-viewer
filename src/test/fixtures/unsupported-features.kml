<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2">
  <Document>
    <name>Everything but the route</name>
    <Style id="pin">
      <IconStyle><Icon><href>http://example.invalid/icons/pin.png</href></Icon></IconStyle>
    </Style>
    <NetworkLink>
      <name>Live feed</name>
      <Link><href>http://example.invalid/feed.kml</href></Link>
    </NetworkLink>
    <GroundOverlay>
      <name>Aerial</name>
      <Icon><href>http://example.invalid/aerial.jpg</href></Icon>
      <LatLonBox><north>51.6</north><south>51.4</south><east>0.1</east><west>-0.1</west></LatLonBox>
    </GroundOverlay>
    <gx:Tour>
      <name>Fly-through</name>
      <gx:Playlist><gx:FlyTo><gx:duration>5</gx:duration></gx:FlyTo></gx:Playlist>
    </gx:Tour>
    <Placemark>
      <name>Park</name>
      <Polygon>
        <outerBoundaryIs><LinearRing>
          <coordinates>0.0000,51.5000 0.0010,51.5000 0.0010,51.5010 0.0000,51.5010 0.0000,51.5000</coordinates>
        </LinearRing></outerBoundaryIs>
      </Polygon>
    </Placemark>
    <Placemark>
      <name>Statue</name>
      <Model>
        <Location><longitude>0.0005</longitude><latitude>51.5005</latitude></Location>
        <Link><href>http://example.invalid/statue.dae</href></Link>
      </Model>
    </Placemark>
    <Placemark>
      <name>The actual route</name>
      <description><![CDATA[<script src="http://example.invalid/evil.js"></script><iframe src="http://example.invalid/"></iframe>Three points by the park.]]></description>
      <styleUrl>#pin</styleUrl>
      <LineString>
        <coordinates>0.0000,51.5000 0.0000,51.5010 0.0000,51.5020</coordinates>
      </LineString>
    </Placemark>
  </Document>
</kml>
